{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["REPO_DOCS_CHANNEL", "REPO_DOCS_URL"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/icons/icons.json",
        "$TURBO_ROOT$/packages/icons/CHANGELOG.md"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/icons/icons.json",
        "$TURBO_ROOT$/packages/icons/CHANGELOG.md"
      ]
    }
  }
}
