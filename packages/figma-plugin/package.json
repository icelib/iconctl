{
  "name": "@iconctl/figma-plugin",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Figma plugin: preflight icons and publish them to GitHub Actions",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/iconctl.git",
    "directory": "packages/figma-plugin"
  },
  "bugs": {
    "url": "https://github.com/icelib/iconctl/issues"
  },
  "keywords": [
    "iconctl",
    "figma",
    "plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "manifest.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown && node scripts/inline-ui.mjs",
    "test": "vitest run",
    "test:dev": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --files test-d/**/*.test-d.ts"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0"
  }
}
