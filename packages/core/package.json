{
  "name": "@iconctl/core",
  "type": "module",
  "version": "0.4.0",
  "description": "Load icons from Figma, SVG directories, and more, then export Iconify JSON",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://github.com/icelib/iconctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/iconctl.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/icelib/iconctl/issues"
  },
  "keywords": [
    "iconify",
    "icons",
    "svg",
    "figma",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./naming": {
      "import": {
        "types": "./dist/naming.d.mts",
        "default": "./dist/naming.mjs"
      },
      "require": {
        "types": "./dist/naming.d.cts",
        "default": "./dist/naming.cjs"
      }
    },
    "./figma/oauth": {
      "import": {
        "types": "./dist/figma-oauth.d.mts",
        "default": "./dist/figma-oauth.mjs"
      },
      "require": {
        "types": "./dist/figma-oauth.d.cts",
        "default": "./dist/figma-oauth.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "THIRD_PARTY_NOTICES",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:package": "pnpm build && pnpm --filter iconctl build && node scripts/test-watch-package.mjs && node scripts/test-naming-package.mjs",
    "test:naming-package": "pnpm build && node scripts/test-naming-package.mjs",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --files test-d/**/*.test-d.ts"
  },
  "dependencies": {
    "@iconify/tools": "^5.0.14",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "c12": "^3.3.1",
    "chokidar": "^5.0.0",
    "pathe": "^2.0.3",
    "proper-lockfile": "^4.1.2",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
