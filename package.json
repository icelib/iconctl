{
  "name": "iconctl-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "Load icons from Figma, SVG directories, and more, then distribute Iconify JSON",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://github.com/icelib/iconctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/iconctl.git"
  },
  "bugs": {
    "url": "https://github.com/icelib/iconctl/issues"
  },
  "keywords": [
    "figma",
    "iconify",
    "icons",
    "svg",
    "cli"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run --passWithNoTests && pnpm run test:automation",
    "test:dev": "vitest",
    "lint": "pnpm run lint:automation && turbo run lint",
    "tsd": "turbo run tsd",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "typecheck": "turbo run typecheck",
    "format": "eslint . --fix",
    "validate": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "release": "pnpm change",
    "publish-packages": "repo release stable publish",
    "release:pre": "repo release pre publish",
    "preinstall": "npx only-allow pnpm",
    "commit": "commit",
    "commitlint": "commitlint --edit",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "pr:alpha": "repo release pre enter alpha",
    "pr:beta": "repo release pre enter beta",
    "pr:rc": "repo release pre enter rc",
    "pr:next": "repo release pre enter next",
    "pr:exit": "repo release pre exit",
    "sync:npmmirror": "repo release sync-npmmirror --all",
    "release:sync-npmmirror": "repo release sync-npmmirror --published",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:deploy:preview": "node scripts/docs/deploy.mjs preview",
    "docs:deploy:stable": "node scripts/docs/deploy.mjs stable",
    "test:automation": "node --test .github/auto-changeset/*.test.mjs scripts/docs/*.test.mjs scripts/release/*.test.mjs",
    "test:package": "pnpm --filter @iconctl/core test:package",
    "lint:automation": "eslint repoctl.config.ts scripts .github/auto-changeset"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/config-inspector": "^3.5.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "~5.0.5",
    "eslint": "^10.12.0",
    "execa": "^10.1.1",
    "lefthook": "2.2.2",
    "only-allow": "^1.2.2",
    "repoctl": "6.0.1",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.33.0",
    "tsdown": "0.23.1",
    "turbo": "^2.11.8",
    "typescript": "6.0.3",
    "vitest": "~5.0.5",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
